{
  "id": "dsh-codex-official-adapter",
  "name": "DSH ChatGPT Adapter",
  "version": "0.1.2",
  "description": "Use your ChatGPT subscription in Harness: sign in without an API key, switch GPT/DeepSeek, and work with images and built-in tools. Desktop 0.2.0-rc.2 only; use the desktop profile.",
  "descriptionZh": "登录 ChatGPT 即可在 Harness 使用订阅模型，无需 API Key。支持 GPT / DeepSeek 切换、图片理解与内置工具。",
  "author": {
    "name": "diwer",
    "url": "https://github.com/diwer"
  },
  "license": "MIT",
  "category": "integration",
  "tags": [
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "dsh",
    "cordis-plugin",
    "chatgpt",
    "gpt",
    "codex",
    "llm-provider",
    "oauth",
    "desktop",
    "vision"
  ],
  "compatibility": {
    "dsh": "0.2.0-rc.2",
    "platforms": [
      "macos"
    ],
    "profiles": [
      "desktop"
    ]
  },
  "install": {
    "target": "git",
    "spec": "github:diwer/dsh-codex-adapter#3e9a48ff1d53154dd46c3ed22803a0a77066b901",
    "command": "dsh plugin --profile {profile} add github:diwer/dsh-codex-adapter#3e9a48ff1d53154dd46c3ed22803a0a77066b901 --ignore-scripts"
  },
  "verified": false,
  "repository": "https://github.com/diwer/dsh-codex-adapter",
  "docs": "https://github.com/diwer/dsh-codex-adapter/blob/main/docs/INSTALLATION.md"
